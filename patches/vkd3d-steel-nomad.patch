+/* Shared fences, within one process only: the handle is an unnamed event that
+ * stands for the fence, OpenSharedHandle() maps it back. Cross-process sharing
+ * would need external semaphores, which MoltenVK lacks.
+ * ponytail: fixed table holding a reference per handle, the fence lives until
+ * its handle value is reused by another CreateSharedHandle(). */
+static struct
+{
+    HANDLE handle;
+    ID3D12Fence *fence;
+} shared_fences[64];
+static SRWLOCK shared_fences_lock = SRWLOCK_INIT;
 
 static HRESULT STDMETHODCALLTYPE d3d12_device_CreateSharedHandle(ID3D12Device9 *iface,
         ID3D12DeviceChild *object, const SECURITY_ATTRIBUTES *attributes, DWORD access,
         const WCHAR *name, HANDLE *handle)
 {
     struct d3d12_device *device = impl_from_ID3D12Device9(iface);
+    ID3D12Fence *fence, *old = NULL;
+    HANDLE event;
+    size_t i, slot = ARRAY_SIZE(shared_fences);
 
-    FIXME("iface %p, object %p, attributes %p, access %#x, name %s, handle %p stub!\n",
+    TRACE("iface %p, object %p, attributes %p, access %#x, name %s, handle %p.\n",
             iface, object, attributes, (uint32_t)access, debugstr_w(name, device->wchar_size), handle);
 
-    return E_NOTIMPL;
+    if (!object || !handle)
+        return E_INVALIDARG;
+    if (FAILED(ID3D12DeviceChild_QueryInterface(object, &IID_ID3D12Fence, (void **)&fence)))
+    {
+        FIXME("Sharing objects other than fences is not implemented.\n");
+        return E_NOTIMPL;
+    }
+    if (!(event = CreateEventW(NULL, FALSE, FALSE, NULL)))
+    {
+        ID3D12Fence_Release(fence);
+        return E_OUTOFMEMORY;
+    }
+
+    AcquireSRWLockExclusive(&shared_fences_lock);
+    for (i = 0; i < ARRAY_SIZE(shared_fences); ++i)
+    {
+        if (shared_fences[i].handle == event)
+        {
+            slot = i;
+            break;
+        }
+        if (!shared_fences[i].fence && slot == ARRAY_SIZE(shared_fences))
+            slot = i;
+    }
+    if (slot < ARRAY_SIZE(shared_fences))
+    {
+        old = shared_fences[slot].fence;
+        shared_fences[slot].handle = event;
+        shared_fences[slot].fence = fence;
+    }
+    ReleaseSRWLockExclusive(&shared_fences_lock);
+
+    if (old)
+        ID3D12Fence_Release(old);
+    if (slot == ARRAY_SIZE(shared_fences))
+    {
+        ERR("Too many shared fences.\n");
+        CloseHandle(event);
+        ID3D12Fence_Release(fence);
+        return E_OUTOFMEMORY;
+    }
+
+    *handle = event;
+    return S_OK;
 }
 
