+#ifdef _WIN32
+/* cuvee: without VK_KHR_external_semaphore_win32 (MoltenVK) a shared fence is a regular one, and
+ * CreateSharedHandle failed on it. 3DMark shares fences inside its own process only: hand out an event
+ * handle as a token for the fence and resolve it in OpenSharedHandle.
+ * ponytail: 64 slots, never freed (a fence shared once lives as long as the process); cross-process
+ * sharing still needs the Vulkan extension. */
+static struct { HANDLE handle; ID3D12Fence *fence; } in_process_fences[64];
+static SRWLOCK in_process_fence_lock = SRWLOCK_INIT;
+
+static HRESULT in_process_fence_share(ID3D12Fence *fence, HANDLE *handle)
+{
+    HRESULT hr = E_OUTOFMEMORY;
+    unsigned int i;
+
+    AcquireSRWLockExclusive(&in_process_fence_lock);
+    for (i = 0; i < ARRAY_SIZE(in_process_fences); ++i)
+    {
+        if (in_process_fences[i].handle) continue;
+        if (!(*handle = CreateEventW(NULL, TRUE, FALSE, NULL))) break;
+        ID3D12Fence_AddRef(fence);
+        in_process_fences[i].handle = *handle;
+        in_process_fences[i].fence = fence;
+        hr = S_OK;
+        break;
+    }
+    ReleaseSRWLockExclusive(&in_process_fence_lock);
+    return hr;
+}
+
+static ID3D12Fence *in_process_fence_open(HANDLE handle)
+{
+    ID3D12Fence *fence = NULL;
+    unsigned int i;
+
+    AcquireSRWLockShared(&in_process_fence_lock);
+    for (i = 0; i < ARRAY_SIZE(in_process_fences); ++i)
+        if (in_process_fences[i].handle == handle) fence = in_process_fences[i].fence;
+    ReleaseSRWLockShared(&in_process_fence_lock);
+    return fence;
+}
+#endif
