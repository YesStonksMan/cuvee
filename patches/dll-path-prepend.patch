+/* cuvee: DXMT (WINEDLLPATH_PREPEND) replaces dxgi.dll, and wine's d3d12 cannot work with DXMT's dxgi
+ * (D3D12CreateDevice fails with E_NOINTERFACE). A program that imports d3d12.dll but not d3d11.dll only
+ * speaks Direct3D 12, so it gets wine's own dxgi and vkd3d; everything else keeps DXMT.
+ * 3DMark's adapter probes adapter_info.exe and dxr_info.exe (dxgi loaded at run time) also get wine's: they
+ * hand the adapter LUID to the D3D12 tests, which look it up through wine's dxgi, and DXMT's LUID has its top
+ * bit set ("Unknown adapter LUID given!", or 3DMark hangs on the result). dxinfo.exe keeps DXMT on purpose:
+ * its D3D11 feature level (11_0 here) bars every DX12 test once 3DMark can match its LUID.
+ * Most games load d3d12.dll at run time (Unity, Unreal), after dxgi: those get wine's dxgi when started with a
+ * Direct3D 12 switch, -dx12 or -d3d12 (Unreal) or -force-d3d12 (Unity), e.g. in Steam's launch options. */
+static BOOL wants_d3d12( const UNICODE_STRING *cmdline )
+{
+    int i;
+
+    if (cmdline) return image_path_has( cmdline, " -dx12" ) || image_path_has( cmdline, " -d3d12" ) ||
+                        image_path_has( cmdline, " -force-d3d12" );
+    for (i = 2; i < main_argc; i++)  /* first process, started from a Unix command line */
+        if (!strcasecmp( main_argv[i], "-dx12" ) || !strcasecmp( main_argv[i], "-d3d12" ) ||
+            !strcasecmp( main_argv[i], "-force-d3d12" )) return TRUE;
+    return FALSE;
+}
+
+static void skip_dll_path_prepend( const char *base, const UNICODE_STRING *nt_name, const UNICODE_STRING *cmdline )
+{
+    unsigned int i, j, k;
+
+    if (!prepend_paths || !prepend_paths[0]) return;
+    if ((!image_imports( base, "d3d12.dll" ) || image_imports( base, "d3d11.dll" ))
+            && !image_path_has( nt_name, "\\adapter_info.exe" ) && !image_path_has( nt_name, "\\dxr_info.exe" )
+            && !wants_d3d12( cmdline ))
+        return;
+
+    for (i = j = 0; dll_paths[i]; i++)
+    {
+        for (k = 0; prepend_paths[k]; k++) if (dll_paths[i] == prepend_paths[k]) break;
+        if (!prepend_paths[k]) dll_paths[j++] = dll_paths[i];
+    }
+    dll_paths[j] = NULL;
+    TRACE( "%s: Direct3D 12 only, ignoring WINEDLLPATH_PREPEND\n", debugstr_us(nt_name) );
+}
