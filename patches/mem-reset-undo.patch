--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -93,6 +93,10 @@
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(virtual);
+
+/* winnt.h has 0x10000000; Windows (and the programs that pass it) use 0x01000000 */
+#undef MEM_RESET_UNDO
+#define MEM_RESET_UNDO 0x01000000
 WINE_DECLARE_DEBUG_CHANNEL(module);
 WINE_DECLARE_DEBUG_CHANNEL(virtual_ranges);
 
@@ -5175,7 +5179,7 @@
 
     /* Compute the alloc type flags */
 
-    if (!(type & (MEM_COMMIT | MEM_RESERVE | MEM_RESET))
+    if (!(type & (MEM_COMMIT | MEM_RESERVE | MEM_RESET | MEM_RESET_UNDO))
         || (type & MEM_REPLACE_PLACEHOLDER && !(type & MEM_RESERVE)))
     {
         WARN("called with wrong alloc type flags (%08x) !\n", type);
@@ -5214,6 +5218,16 @@
     {
         if (!(view = find_view( base, size ))) status = STATUS_NOT_MAPPED_VIEW;
         else madvise( base, size, MADV_DONTNEED );
+    }
+    else if (type & MEM_RESET_UNDO)
+    {
+        /* Chromium's discardable memory relies on it: when it fails, every lock reports the memory as
+         * purged and decoded images are decoded again for each tile. On macOS MADV_DONTNEED only
+         * deactivates the pages, so their contents are still there. Elsewhere it may have dropped them. */
+        if (!(view = find_view( base, size ))) status = STATUS_NOT_MAPPED_VIEW;
+#ifndef __APPLE__
+        else status = STATUS_INVALID_PARAMETER;
+#endif
     }
     else  /* commit the pages */
     {
@@ -5262,7 +5276,7 @@
 NTSTATUS WINAPI NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR zero_bits,
                                          SIZE_T *size_ptr, ULONG type, ULONG protect )
 {
-    static const ULONG type_mask = MEM_COMMIT | MEM_RESERVE | MEM_TOP_DOWN | MEM_WRITE_WATCH | MEM_RESET;
+    static const ULONG type_mask = MEM_COMMIT | MEM_RESERVE | MEM_TOP_DOWN | MEM_WRITE_WATCH | MEM_RESET | MEM_RESET_UNDO;
     ULONG_PTR limit;
 
     TRACE("%p %p %08lx %x %08x\n", process, *ret, *size_ptr, type, protect );
